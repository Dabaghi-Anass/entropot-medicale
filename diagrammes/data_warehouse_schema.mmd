erDiagram
    %% Data Warehouse Star Schema - Facts and Dimensions

    %% Fact Tables
    fact_emergency_passages {
        int time_id FK
        int hospital_id FK
        varchar age_category
        int total_passages
        int corona_passages
        int corona_hospitalizations
        int passages_male
        int passages_female
        int corona_passages_male
        int corona_passages_female
        int corona_hosp_male
        int corona_hosp_female
        int total_acts
        int corona_acts
        int acts_male
        int acts_female
        int corona_acts_male
        int corona_acts_female
        int department_id FK
        int source_record_id
    }

    fact_hospital_stats {
        int hospital_id FK
        int time_id FK
        int capacity_beds
        int doctors_count
        int nurses_count
        varchar services
        varchar specialties
        varchar equipment
        varchar management_mode
        varchar legal_status
    }

    %% Dimension Tables
    dim_time {
        int time_id PK
        date date
        int day
        int month
        int year
        int quarter
        int day_of_week
        varchar day_name
        varchar month_name
        boolean is_weekend
    }

    dim_regions {
        int region_id PK
        varchar region_name
        varchar region_code
    }

    dim_departments {
        int department_id PK
        varchar department_name
        varchar department_code
        int region_id FK
    }

    dim_cities {
        int city_id PK
        varchar city_name
        varchar postal_code
        int department_id FK
        decimal latitude
        decimal longitude
    }

    dim_facility_types {
        int facility_type_id PK
        varchar facility_type_name
        varchar facility_category
    }

    dim_ownership_types {
        int ownership_type_id PK
        varchar ownership_type_name
    }

    dim_sources {
        int source_id PK
        varchar source_name
        varchar source_description
    }

    dim_hospitals {
        int hospital_id PK
        varchar hospital_name
        varchar hospital_name_clean
        varchar address
        int city_id FK
        int department_id FK
        int region_id FK
        varchar phone
        varchar fax
        decimal latitude
        decimal longitude
        int facility_type_id FK
        int ownership_type_id FK
        int capacity_beds
        varchar services
        varchar website
        varchar finess_code
        varchar siret_code
        date opening_date
        int source_id FK
    }

    dim_doctors {
        int doctor_id PK
        varchar rpps_number
        varchar first_name
        varchar last_name
        varchar full_name
        varchar specialty
        date accreditation_date
        varchar organization_accreditation
        varchar team_name
        varchar department
        varchar employment_status
    }

    %% Relationships
    fact_emergency_passages ||--o{ dim_time : "time_id"
    fact_emergency_passages ||--o{ dim_hospitals : "hospital_id"
    fact_emergency_passages ||--o{ dim_departments : "department_id"

    fact_hospital_stats ||--o{ dim_hospitals : "hospital_id"
    fact_hospital_stats ||--o{ dim_time : "time_id"

    dim_departments ||--o{ dim_regions : "region_id"
    dim_cities ||--o{ dim_departments : "department_id"
    dim_hospitals ||--o{ dim_cities : "city_id"
    dim_hospitals ||--o{ dim_departments : "department_id"
    dim_hospitals ||--o{ dim_regions : "region_id"
    dim_hospitals ||--o{ dim_facility_types : "facility_type_id"
    dim_hospitals ||--o{ dim_ownership_types : "ownership_type_id"
    dim_hospitals ||--o{ dim_sources : "source_id"